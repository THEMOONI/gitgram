{
  "name": "TIFI tokens",
  "version": "1.0.0",
  "cssPrefix": "--tifi-",
  "scope": [
    ".tifi",
    "[data-app=\"tifi\"]"
  ],
  "contrast": {
    "text-1 on bg-2": "15.9:1",
    "text-2 on bg-2": "8.7:1",
    "text-3 on bg-2": "5.6:1",
    "on-orange on orange": "7.5:1",
    "white on orange": "2.6:1 (FAIL, do not use)",
    "orange-text on bg-2": "8.5:1",
    "ai on bg-2": "6.5:1",
    "up on bg-2": "10.2:1",
    "down on bg-2": "6.1:1"
  },
  "tokens": {
    "color": {
      "bg-0": "#07080A",
      "bg-1": "#0E0F12",
      "bg-2": "#15171B",
      "bg-3": "#1D2026",
      "line": "#2A2D34",
      "line-2": "#393D46",
      "text-1": "#F3F1EE",
      "text-2": "#B9B4AC",
      "text-3": "#948F87",
      "orange": "#FF7A1A",
      "orange-hover": "#FF8F3D",
      "orange-press": "#E8590C",
      "orange-text": "#FF9A4D",
      "orange-soft": "rgba(255,122,26,.12)",
      "orange-line": "rgba(255,122,26,.40)",
      "on-orange": "#0B0B0C",
      "up": "#3DDC97",
      "up-soft": "rgba(61,220,151,.12)",
      "down": "#FF5D7A",
      "down-soft": "rgba(255,93,122,.12)",
      "flat": "#948F87",
      "ai": "#9A8CFF",
      "ai-soft": "rgba(154,140,255,.14)",
      "ai-line": "rgba(154,140,255,.45)",
      "t1": "#FF7A1A",
      "t2": "#FFB547",
      "t3": "#EDE6DA"
    },
    "font": {
      "display": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
      "ui": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "12.5px",
      "md": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "28px",
      "3xl": "36px"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px"
    },
    "radius": {
      "radius-sm": "6px",
      "radius": "10px",
      "radius-lg": "14px",
      "radius-xl": "20px",
      "radius-pill": "999px"
    },
    "shadow": {
      "glow-sm": "0 0 0 1px rgba(255,122,26,.35), 0 0 12px rgba(255,122,26,.25)",
      "glow-md": "0 0 0 1px rgba(255,122,26,.45), 0 0 24px rgba(255,122,26,.30)",
      "glow-lg": "0 0 40px rgba(255,122,26,.35), 0 0 90px rgba(255,122,26,.15)",
      "shadow-card": "0 20px 50px -24px rgba(0,0,0,.8)",
      "focus-ring": "0 0 0 2px #07080A, 0 0 0 4px #FF9A4D"
    },
    "other": {
      "stripes": "repeating-linear-gradient(135deg, #FF7A1A 0 12px, #E8590C 12px 24px)"
    }
  }
}
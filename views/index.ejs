<%- include('partials/header') %><div class="hero"><div class="hero-content"><div class="hero-badge"><span class="dot"></span><span>Self-hosted &middot; Open source &middot; Free forever</span></div><h1>The future of Git<br>is <span class="gradient-text">yours to own</span></h1><p class="hero-subtitle">Your code, your infrastructure, your rules. GITGRAM is the self-hosted Git platform that puts you in complete control.</p><% if (!currentUser) { %><div class="hero-actions"><a href="/register" class="btn btn-primary btn-lg">Start for free &rarr;</a><a href="/login" class="btn btn-outline btn-lg">Sign in</a></div><% } else { %><div class="hero-actions"><a href="/new" class="btn btn-primary btn-lg">Create a repository</a><a href="/@<%= currentUser.username %>" class="btn btn-outline btn-lg">My repos</a></div><% } %></div></div><div class="container"><div class="section"><h2 class="section-title">📦 Public Repositories</h2><% if (repos.length === 0) { %><div style="text-align:center;padding:60px;color:var(--text-secondary);"><p>No public repositories yet. Be the first!</p></div><% } else { %><div class="repo-list"><% repos.forEach(function(repo) { %><div class="repo-card"><div class="repo-card-header"><a href="/<%= repo.full_name %>" class="repo-name"><span class="repo-owner"><%= repo.owner_name %></span><span class="repo-separator">/</span><span class="repo-project"><%= repo.name %></span></a><% if (repo.private) { %><span class="badge badge-private">Private</span><% } else { %><span class="badge badge-public">Public</span><% } %></div><% if (repo.description) { %><p class="repo-description"><%= repo.description %></p><% } %><div class="repo-meta"><span> Updated <%= moment(repo.updated_at).fromNow() %></span></div></div><% }); %></div><% } %></div><div class="features-section"><h2 class="section-title">✨ Why teams choose GITGRAM</h2><div class="features-grid"><div class="feature-card"><div class="feature-icon">🏠</div><h3>Fully self-hosted</h3><p>Your code never leaves your servers. Complete data sovereignty.</p></div><div class="feature-card"><div class="feature-icon">🔒</div><h3>Private by default</h3><p>Granular access control keeps sensitive projects locked down.</p></div><div class="feature-card"><div class="feature-icon"></div><h3>Built for speed</h3><p>Node.js and SQLite power a lean, fast experience.</p></div><div class="feature-card"><div class="feature-icon">🆓</div><h3>Zero cost, forever</h3><p>Open source under MIT license. No paywalls.</p></div></div></div></div><%- include('partials/footer') %>

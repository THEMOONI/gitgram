<%- include('partials/header', { homePage: true }) %>
<div class="home">
  <section class="home-hero">
    <p class="home-kicker"><span class="home-kicker-dot"></span> Self-hosted · Open source · Early stage</p>
    <h1>A small Git host<br>you <span>run yourself</span></h1>
    <p class="home-lead">Scavvers is a small, self-hosted, open-source Git platform (MIT, &copy; 2026 Scavvers Labs). It runs on Node.js, Express, and SQLite, stores bare repositories on disk, and uses ordinary <code>git clone</code> and <code>git push</code> over HTTP. The project is at an early stage.</p>
    <div class="home-actions">
      <% if (!currentUser) { %>
        <a class="btn btn-primary btn-lg" href="/register">Create an account</a>
        <a class="btn btn-outline btn-lg" href="#repos">Explore public repos</a>
      <% } else { %>
        <a class="btn btn-primary btn-lg" href="/new">Create a repository</a>
        <a class="btn btn-outline btn-lg" href="/@<%= currentUser.username %>">My repos</a>
      <% } %>
    </div>
    <p class="home-clone"><span>$</span> <code>git clone &lt;your-server&gt;/owner/repo.git</code></p>
    <p class="home-note">Example only. The repository page shows the URL for this server. New repositories are public unless you mark them private.</p>
  </section>

  <section id="repos" class="home-section">
    <p class="home-eyebrow">Explore</p>
    <h2>Public repositories</h2>
    <p class="home-intro">Repositories on this server that are public. This list is not sample data.</p>
    <% if (repos.length === 0) { %>
      <div class="home-empty">No public repositories yet.</div>
    <% } else { %>
      <div class="home-repo-list">
        <% repos.forEach(function(repo) { %>
          <a class="home-repo" href="/<%= repo.full_name %>">
            <span class="home-repo-name"><%= repo.owner_name %>/<%= repo.name %></span>
            <span class="home-repo-badge">Public</span>
            <% if (repo.description) { %><span class="home-repo-desc"><%= repo.description %></span><% } %>
            <span class="home-repo-meta">Updated <%= moment(repo.updated_at).fromNow() %></span>
          </a>
        <% }); %>
      </div>
    <% } %>
  </section>

  <section id="agents" class="home-section">
    <p class="home-eyebrow">Under utveckling</p>
    <h2>Agents</h2>
    <div class="home-placeholder">
      <p>AI agents are not in this version of Scavvers. Nothing here reviews pull requests or ships code.</p>
    </div>
  </section>

  <section id="wallet" class="home-section">
    <p class="home-eyebrow">Under utveckling</p>
    <h2>Wallet and trading</h2>
    <p class="home-flag">Demo, låtsaspengar, ingen riktig handel, ingen finansiell rådgivning.</p>
    <p class="home-flag">Demo only, play money, no real trading, not financial advice.</p>
    <p class="home-intro">No wallet and no trading run in this version. There is no balance, no order, and no return.</p>
  </section>

  <section class="home-section">
    <p class="home-eyebrow">Today</p>
    <h2>What Scavvers does today</h2>
    <div class="home-cards">
      <article class="home-card">
        <h3>Self-hosted</h3>
        <p>You run Scavvers on your own server. Repositories are ordinary bare Git repositories on disk.</p>
      </article>
      <article class="home-card">
        <h3>Public by default</h3>
        <p>New repositories are public. A private repository is visible to its owner only. There are no collaborators.</p>
      </article>
      <article class="home-card">
        <h3>Small stack</h3>
        <p>The app is Node.js and Express. Users and repository metadata live in SQLite.</p>
      </article>
      <article class="home-card">
        <h3>MIT license</h3>
        <p>Open source under the MIT license. Copyright &copy; 2026 Scavvers Labs.</p>
      </article>
    </div>
  </section>
</div>
<%- include('partials/footer') %>

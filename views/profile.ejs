<%- include('partials/header') %><div class="container"><div class="profile-header"><div style="width:80px;height:80px;border-radius:20px;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:800;color:white;"><%= user.username.charAt(0).toUpperCase() %></div><div><h1 style="font-size:1.6rem;font-weight:800;margin-bottom:4px;"><%= user.username %></h1><div style="color:var(--text-muted);font-size:0.8rem;margin-top:8px;">📅 Joined <%= moment(user.created_at).format('MMMM YYYY') %></div><% if (isOwner) { %><p style="margin-top:8px;color:var(--text-secondary);font-size:0.85rem;">📧 <%= user.email %></p><% } %></div></div><div class="section"><div class="section-header"><h2>Repositories</h2><% if (isOwner) { %><a href="/new" class="btn btn-primary btn-sm">+ New Repository</a><% } %></div><% if (repos.length === 0) { %><div style="text-align:center;padding:60px;color:var(--text-secondary);"><p>No repositories yet.</p><% if (isOwner) { %><a href="/new" class="btn btn-primary" style="margin-top:16px;">Create your first repository</a><% } %></div><% } else { %><div class="repo-list"><% repos.forEach(function(repo) { %><div class="repo-card"><div class="repo-card-header"><a href="/<%= repo.full_name %>" class="repo-name"><span class="repo-project"><%= repo.name %></span></a><% if (repo.private) { %><span class="badge badge-private">Private</span><% } else { %><span class="badge badge-public">Public</span><% } %></div><% if (repo.description) { %><p class="repo-description"><%= repo.description %></p><% } %><div class="repo-meta"><span>🔀 <%= repo.default_branch %></span><span>📅 Updated <%= moment(repo.updated_at).fromNow() %></span></div></div><% }); %></div><% } %></div></div><%- include('partials/footer') %>

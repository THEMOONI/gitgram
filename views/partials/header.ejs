<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof homePage !== 'undefined' && homePage) { %><link rel="stylesheet" href="/css/home.css"><% } %>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
</head>
<body<% if (typeof homePage !== 'undefined' && homePage) { %> class="home"<% } %>>
<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand"><img class="brand-wordmark" src="/brand/scavvers-wordmark-transparent-512.png" srcset="/brand/scavvers-wordmark-transparent-512.png 1x, /brand/scavvers-wordmark-transparent-1024.png 2x" alt="Scavvers" width="90" height="32"></a>
    <div class="nav-sections">
      <a href="/#repos">Explore</a>
      <a href="/#repos">Repositories</a>
      <a href="/#agents">Agents <span class="nav-soon">Under utveckling</span></a>
      <a href="/#wallet">Wallet <span class="nav-soon">Under utveckling</span></a>
    </div>
    <div class="nav-search">
      <input type="text" id="searchInput" placeholder="Search repositories...">
      <div id="searchResults" class="search-results" style="position:absolute;top:100%;left:0;right:0;background:var(--bg-elevated);border:1px solid var(--border-light);border-radius:var(--radius);margin-top:8px;display:none;max-height:300px;overflow-y:auto;z-index:200;"></div>
    </div>
    <div class="nav-links">
      <% if (currentUser) { %>
        <a href="/new" class="btn btn-primary btn-sm">+ New Repo</a>
        <a href="/@<%= currentUser.username %>" class="nav-user"><span class="avatar-small"><%= currentUser.username.charAt(0).toUpperCase() %></span><span><%= currentUser.username %></span></a>
        <form method="POST" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost btn-sm">Log out</button></form>
      <% } else { %>
        <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
        <a href="/register" class="btn btn-primary btn-sm">Get started</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="main-content">

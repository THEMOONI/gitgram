<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><polygon points='50,8 92,29 92,71 50,92 8,71 8,29' fill='%237c3aed'/></svg>"></head><body><nav class="navbar"><div class="nav-container"><a href="/" class="nav-brand"><svg width="32" height="32" viewBox="0 0 100 100"><polygon points="50,8 92,29 92,71 50,92 8,71 8,29" fill="url(#lg)"/><defs><linearGradient id="lg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#7c3aed"/><stop offset="50%" stop-color="#2563eb"/><stop offset="100%" stop-color="#06b6d4"/></linearGradient></defs><circle cx="50" cy="50" r="5" fill="white"/><circle cx="35" cy="35" r="3" fill="white" opacity="0.8"/><circle cx="65" cy="30" r="3" fill="white" opacity="0.8"/><circle cx="30" cy="65" r="3" fill="white" opacity="0.8"/><circle cx="70" cy="70" r="3" fill="white" opacity="0.8"/><line x1="35" y1="35" x2="50" y2="50" stroke="white" stroke-width="2" opacity="0.8"/><line x1="65" y1="30" x2="50" y2="50" stroke="white" stroke-width="2" opacity="0.8"/><line x1="30" y1="65" x2="50" y2="50" stroke="white" stroke-width="2" opacity="0.8"/><line x1="70" y1="70" x2="50" y2="50" stroke="white" stroke-width="2" opacity="0.8"/></svg><span class="logo-text">GITGRAM</span></a><div class="nav-search"><input type="text" id="searchInput" placeholder="Search repositories..."><div id="searchResults" class="search-results" style="position:absolute;top:100%;left:0;right:0;background:var(--bg-elevated);border:1px solid var(--border-light);border-radius:var(--radius);margin-top:8px;display:none;max-height:300px;overflow-y:auto;z-index:200;"></div></div><div class="nav-links"><% if (currentUser) { %><a href="/team" class="btn btn-ghost btn-sm">Team</a><a href="/new" class="btn btn-primary btn-sm">+ New Repo</a
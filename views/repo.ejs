<%- include('partials/header') %><div class="container"><div class="repo-header"><div><h1 class="repo-title"><a href="/@<%= repo.owner_name %>" class="repo-title-owner"><%= repo.owner_name %></a><span style="color:var(--text-muted);margin:0 4px;">/</span><a href="/<%= repo.full_name %>" class="repo-title-name"><%= repo.name %></a><% if (repo.private) { %><span class="badge badge-private">Private</span><% } else { %><span class="badge badge-public">Public</span><% } %></h1></div><% if (repo.description) { %><p style="color:var(--text-secondary);margin:8px 0 16px;font-size:0.9rem;"><%= repo.description %></p><% } %><div class="repo-actions"><div class="clone-url"><span style="color:var(--text-muted);">Clone:</span><code id="cloneUrl"><%= publicUrl %>/<%= repo.full_name %>.git</code><button class="btn btn-sm btn-ghost" onclick="navigator.clipboard.writeText(document.getElementById('cloneUrl').textContent);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000);">Copy</button></div><% if (isOwner) { %><a href="/<%= repo.full_name %>/settings" class="btn btn-sm btn-ghost">️ Settings</a><% } %></div><div class="repo-nav"><a href="/<%= repo.full_name %>" class="repo-nav-item active">📁 Code</a><a href="/<%= repo.full_name %>/commits" class="repo-nav-item">📝 Commits</a></div></div><% if (!hasCommits) { %><div class="empty-repo"><h2>Quick setup</h2><p style="color:var(--text-secondary);margin-bottom:24px;">This repository is empty. Get started by pushing your first code.</p><div class="setup-instructions"><div class="setup-section"><h3>…or create a new repository on the command line</h3><div class="code-block"><pre><code>echo "# <%= repo.name %>" > README.md
git init
git add README.md
git commit -m "first commit"
git branch -M main
git remote add origin <%= publicUrl %>/<%= repo.full_name %>.git
git push -u origin main</code></pre></div></div><div class="setup-section"><h3>…or push an existing repository</h3><div class="code-block"><pre><code>git remote add origin <%= publicUrl %>/<%= repo.full_name %>.git
git branch -M main
git push -u origin main</code></pre></div></div></div></div><% } else { %><div style="display:flex;flex-direction:column;gap:20px;"><div class="file-browser"><div class="file-browser-header"><span class="branch-badge">🔀 <%= ref %></span><span style="font-size:0.85rem;"><a href="/<%= repo.full_name %>/tree/<%= encodeURIComponent(ref) %>" style="color:#60a5fa;"><%= repo.name %></a><% breadcrumbs.forEach(function(crumb) { %> / <% if (crumb.isLast) { %><strong><%= crumb.name %></strong><% } else { %><a href="/<%= repo.full_name %>/tree/<%= encodeURIComponent(ref) %>/<%= crumb.path.split('/').map(encodeURIComponent).join('/') %>" style="color:#60a5fa;"><%= crumb.name %></a><% } %><% }); %></span><% if (commits.length > 0) { %><span style="color:var(--text-muted);font-size:0.8rem;"><%= commits.length %> commit<%= commits.length !== 1 ? 's' : '' %></span><% } %></div><div><% if (currentPath !== '') { %><div class="file-item"><span>📁</span><a href="/<%= repo.full_name %>/tree/<%= encodeURIComponent(ref) %><%= breadcrumbs.length > 1 ? '/' + breadcrumbs[breadcrumbs.length - 2].path.split('/').map(encodeURIComponent).join('/') : '' %>" class="file-name">..</a></div><% } %><% files.forEach(function(file) { %><div class="file-item"><span><%= file.isDir ? '📁' : '📄' %></span><a href="/<%= repo.full_name %>/<%= file.isDir ? 'tree' : 'blob' %>/<%= encodeURIComponent(ref) %>/<%= file.path.split('/').map(encodeURIComponent).join('/') %>" class="file-name"><%= file.name %></a></div><% }); %></div></div><% if (readme) { %><div class="readme-section"><div class="readme-header">📖 README</div><div class="readme-content"><pre><%= readme %></pre></div></div><% } %><% if (commits.length > 0) { %><div class="readme-section"><div class="readme-header">Recent commits</div><div><% commits.slice(0,5).forEach(function(commit) { %><div class="commit-item"><span style="font-size:0.85rem;"><%= commit.message %></span><span class="commit-hash"><%= commit.shortHash %></span></div><% }); %></div><% if (commits.length > 5) { %><a href="/<%= repo.full_name %>/commits" style="display:block;text-align:center;padding:14px;color:#60a5fa;font-weight:600;font-size:0.85rem;">View all commits →</a><% } %></div><% } %></div><% } %></div><%- include('partials/footer') %>

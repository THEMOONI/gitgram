<%- include('partials/header') %><div class="container auth-container"><div class="auth-card wide-card"><h1>Create a new repository</h1><p class="auth-subtitle">A repository contains all your project files and their revision history.</p><% if (error) { %><div class="alert alert-error">⚠️ <%= error %></div><% } %><form method="POST" action="/new" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-group"><label>Repository name</label><input type="text" name="name" required autofocus pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,99}"></div><div class="form-group"><label>Description <span style="color:var(--text-muted);font-weight:400;">(optional)</span></label><textarea name="description" rows="3"></textarea></div><div class="form-group"><label style="display:flex;align-items:flex-start;gap:12px;text-transform:none;letter-spacing:0;padding:12px;background:var(--bg-tertiary);border-radius:var(--radius);border:1px solid var(--border);cursor:pointer;"><input type="checkbox" name="is_private" value="1" style="margin-top:2px;"><div><strong>Private repository</strong><p style="color:var(--text-muted);font-size:0.8rem;margin-top:4px;">Only you and people you choose can see this repository.</p></div></label></div><button type="submit" class="btn btn-primary btn-block">Create repository</button></form></div></div><%- include('partials/footer') %>

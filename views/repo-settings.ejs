<%- include('partials/header') %><div class="container"><div class="repo-header"><h1 class="repo-title"><a href="/@<%= repo.owner_name %>" class="repo-title-owner"><%= repo.owner_name %></a><span style="color:var(--text-muted);margin:0 4px;">/</span><a href="/<%= repo.full_name %>" class="repo-title-name"><%= repo.name %></a></h1><div class="repo-nav"><a href="/<%= repo.full_name %>" class="repo-nav-item">📁 Code</a><a href="/<%= repo.full_name %>/commits" class="repo-nav-item"> Commits</a><a href="/<%= repo.full_name %>/settings" class="repo-nav-item active">⚙️ Settings</a></div></div><div style="margin-top:24px;"><h2 style="margin-bottom:20px;">Repository Settings</h2><div class="settings-card"><h3>Danger Zone</h3><p style="color:var(--text-secondary);margin-bottom:20px;font-size:0.85rem;">Once you delete a repository, there is no going back.</p><form method="POST" action="/<%= repo.full_name %>/settings/delete" onsubmit="return confirm('Are you sure? This cannot be undone.');"><button type="submit" class="btn btn-danger">️ Delete this repository</button></form></div></div></div><%- include('partials/footer') %>

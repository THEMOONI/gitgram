<%- include('partials/header') %><div class="container"><div class="repo-header"><h1 class="repo-title"><a href="/@<%= repo.owner_name %>" class="repo-title-owner"><%= repo.owner_name %></a><span style="color:var(--text-muted);margin:0 4px;">/</span><a href="/<%= repo.full_name %>" class="repo-title-name"><%= repo.name %></a></h1><div class="repo-nav"><a href="/<%= repo.full_name %>" class="repo-nav-item">📁 Code</a><a href="/<%= repo.full_name %>/commits" class="repo-nav-item active"> Commits</a></div></div><h2 class="section-title">Commit History</h2><% if (commits.length === 0) { %><div style="text-align:center;padding:60px;color:var(--text-secondary);"><p>No commits yet.</p></div><% } else { %><div class="commit-list-full"><% commits.forEach(function(commit) { %><div class="commit-item-full"><div><p class="commit-message-full"><%= commit.message %></p><div class="commit-meta"><span><%= commit.author %></span><span style="margin-left:12px;"><%= moment(commit.date).fromNow() %></span></div></div><span class="commit-hash-full"><%= commit.shortHash %></span></div><% }); %></div><% } %></div><%- include('partials/footer') %>

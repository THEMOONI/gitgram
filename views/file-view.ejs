<%- include('partials/header') %><div class="container"><div class="repo-header"><h1 class="repo-title"><a href="/@<%= repo.owner_name %>" class="repo-title-owner"><%= repo.owner_name %></a><span style="color:var(--text-muted);margin:0 4px;">/</span><a href="/<%= repo.full_name %>" class="repo-title-name"><%= repo.name %></a></h1><div class="repo-nav"><a href="/<%= repo.full_name %>" class="repo-nav-item">📁 Code</a><a href="/<%= repo.full_name %>/commits" class="repo-nav-item">📝 Commits</a></div></div><div class="file-viewer"><div class="file-viewer-header"><span style="font-size:0.85rem;"><a href="/<%= repo.full_name %>" style="color:#60a5fa;"><%= repo.name %></a> / <strong><%= filepath %></strong></span><span style="color:var(--text-muted);font-size:0.8rem;"><%= content.split('\n').length %> lines</span></div><div style="overflow-x:auto;"><table class="code-table"><tbody><% content.split('\n').forEach(function(line, i) { %><tr><td class="line-number"><%= i + 1 %></td><td class="line-content"><pre><%= line %></pre></td></tr><% }); %></tbody></table></div></div></div><%- include('partials/footer') %>

{
  "name": "gitgram",
  "version": "1.0.0",
  "description": "Self-hosted Git platform",
  "main": "server.js",
  "scripts": {
    "start": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' node server.js",
    "test": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tifi:demo": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' node scripts/tifi-demo.js",
    "tifi:backtest": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' node scripts/tifi-backtest.js",
    "licenses": "node scripts/third-party-notices.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THEMOONI/gitgram.git"
  },
  "keywords": [],
  "author": "Scavvers Labs",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/THEMOONI/gitgram/issues"
  },
  "homepage": "https://github.com/THEMOONI/gitgram#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "compression": "^1.8.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}

# Copy to .env and adjust. Load it with: node --env-file=.env server.js

# Port the HTTP server listens on. Use 0 for an ephemeral port.
PORT=3000

# Signs session cookies. REQUIRED when NODE_ENV=production; the server exits
# without it. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Base URL shown in the clone instructions. Set this to the externally
# reachable address when running behind a proxy or on a non-default port.
PUBLIC_URL=http://localhost:3000

# Set to production to enable secure cookies and hide error details.
NODE_ENV=development

# Passed to Express's "trust proxy" setting. Set when running behind a reverse
# proxy so that secure cookies and client IPs are handled correctly.
# TRUST_PROXY=1

# Where bare repositories and the SQLite database live. Both default to
# locations inside the checkout.
# GITGRAM_DATA_DIR=./data
# GITGRAM_DB_PATH=./db/gitgram.db

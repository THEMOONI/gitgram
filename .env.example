# Copy to .env and fill in. Never commit real keys.

# Required in production. Long random string.
SESSION_SECRET=

# Optional server settings
PORT=3000
PUBLIC_URL=http://localhost:3000
GITGRAM_DB=
GITGRAM_DATA=
GITGRAM_URL=http://127.0.0.1:3000

# Language model. Leave LLM_PROVIDER=fake to run with no API key.
# Set LLM_PROVIDER=openai and OPENAI_API_KEY to use a real model.
LLM_PROVIDER=fake
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ESTIMATE_TOKENS=500
LLM_CENTS_PER_1K_TOKENS=0

# Voice. Leave VOICE_PROVIDER empty or set it to none for text only.
# VOICE_PROVIDER=fake uses a local stub (tests and offline demos).
# VOICE_PROVIDER=openai sends audio to OpenAI when OPENAI_API_KEY is set.
VOICE_PROVIDER=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Raw voice audio is transcribed in memory and discarded. Leave this at 0.
# Set TEAM_RETAIN_VOICE=1 only to store recordings under data/voice-retained/.
TEAM_RETAIN_VOICE=0

# Agent hop limit (1-8). Default is 3.
TEAM_MAX_HOPS=3

# Bearer token for POST/GET /api/team/flags. The endpoint is disabled when this is empty.
TEAM_FLAGS_TOKEN=
